{
  "name": "bino-devcont",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/rust:2-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {},
    "ghcr.io/devcontainers-extra/features/claude-code:1": {},
    "ghcr.io/devcontainers-extra/features/typescript:2": {}
  },

  // Use 'mounts' to make the cargo cache persistent in a Docker Volume.
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerUser": "vscode",
  "mounts": [
    "source=/mnt/ext/,target=/mnt/ext/,readonly,type=bind",
    "source=${localEnv:HOME}/.claude/,target=/home/vscode/.claude/,type=bind,consistency=cached",
    "source=/usr/lib/wsl,target=/usr/lib/wsl,readonly,type=bind",
    "source=bino-cargo-registry,target=/home/vscode/.cargo/registry,type=volume",
    "source=bino-cargo-git,target=/home/vscode/.cargo/git,type=volume"
  ],
  "runArgs": ["--gpus=all", "--env=NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility,display"],
  "postCreateCommand": "echo /usr/lib/wsl/lib | sudo tee /etc/ld.so.conf.d/wsl.conf && sudo ldconfig && sudo chown -R vscode:vscode /home/vscode/.cargo/registry /home/vscode/.cargo/git"

  // 👇 Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // 👇 Configure tool-specific properties.
  // "customizations": {},

  // 👇 Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
