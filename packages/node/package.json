{
  "name": "@bino/node",
  "version": "0.0.0",
  "description": "Bino headless renderer service — drives @bino/core kernels in a Node process",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bino-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bino/core": "workspace:*",
    "@eclipse-zenoh/zenoh-ts": "^1.9.0",
    "@kmamal/gl": "^9.1.0",
    "three": "0.160.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.160.0",
    "typescript": "^5.6.3",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.5"
  }
}
